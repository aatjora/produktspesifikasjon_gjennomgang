       <sc:name>Nedlagt</sc:name>
       <sc:id>C18_4</sc:id>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>TypeRastoffVirksomhet</sc:name>
     <sc:id>C19</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>angir type/status på eventuell aktivitet</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>Prospektering</sc:name>
       <sc:id>C19_1</sc:id>
