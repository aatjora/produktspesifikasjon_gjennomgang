    </sc:Class>
    <sc:Class>
     <sc:name>Losmassetype</sc:name>
     <sc:id>C20</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>kvartærgeologiske løsmassetyper (jordartstyper)

Merknad: Nærmere forklaring til definisjoner og dannelsesmåte er å finne i heftet; Kvartærgeologisk kart over Norge, 1:1 mill., tema jordarter (Thoresen M, Norges geologiske undersøkelse, 1991) og i NGU intern-rapport 2001.018 (Bergstrøm m.fl.).</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>http://skjema.geonorge.no/legg_inn_riktig_url</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
     <sc:properties>
      <sc:Property>
       <sc:name>Morenemateriale, uspesifisert</sc:name>
       <sc:id>C20_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale plukket opp, transportert og avsatt av isbreer. Det er vanligvis, dårlig sortert og kan inneholde alt fra leir til stein og blokk. Mektighet, morenetype og overflateform kan variere. Benyttes ved kartframstilling i svært små målestokker.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Morenemateriale, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale plukket opp, transportert og avsatt av isbreer, vanligvis hardt sammenpakket, dårlig sortert og kan inneholde alt fra leir til stein og blokk. Moreneavsetninger med tykkelse fra 0,5 m til flere ti-talls meter. Det er få eller ingen fjellblotninger i området.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Morenemateriale, usammenhengende eller tynt dekke over berggrunnen</sc:name>
       <sc:id>C20_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale plukket opp, transportert og avsatt av isbreer. Det er vanligvis hardt sammenpakket, dårlig sortert og kan inneholde alt fra leir til stein og blokk. Områder med grunnlendte moreneavsetninger/hyppige fjellblotninger. Tykkelsen på avsetningene er normalt mindre enn 0,5 m, men den kan helt lokalt være noe mer.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Moreneleire</sc:name>
       <sc:id>C20_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Morenemateriale med særlig høyt leir- og siltinnhold, oftest meget kompakt.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avsmeltningsmorene (Ablasjonsmorene)</sc:name>
       <sc:id>C20_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Hauger og rygger med løst lagret, delvis vannbehandlet og noe sortert morenemateriale avsatt fra stagnerende breer (dødis). Terrenget er preget av haug- og ryggformer med vekslende orientering.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Randmorene/randmorenebelte</sc:name>
       <sc:id>C20_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Rygger eller belter av morenemateriale som er skjøvet opp foran brefronten. Materialet er usortert og inneholder alle kornstørrelser fra leir til blokk. Noen steder kan morenematerialet finnes i veksling med breelvmateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Drumlin</sc:name>
       <sc:id>C20_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Langstrakt, rettlinjet morenerygg dannet langs isbevegelsesretningen i bunnen av en bre. Ofte stor tykkelse, avrundet form og lengden kan være opp til noen km.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Rogenmorene</sc:name>
       <sc:id>C20_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Rygger av morenemateriale, orientert på tvers av brebevegelsen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Breelvavsetning (Glasifluvial avsetning)</sc:name>
       <sc:id>C20_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale transportert og avsatt av breelver. Sedimentet består av sorterte, ofte skråstilte lag av forskjellig kornstørrelse fra fin sand til stein og blokk. Breelvavsetninger har ofte klare overflateformer som terrasser, rygger og vifter. Mektigheten er ofte flere ti-talls meter.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>9</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Breelv- og elveavsetning</sc:name>
       <sc:id>C20_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale transportert og avsatt av elver eller breelver. Sedimentet består av sorterte lag av forskjellig kornstørrelse fra fin sand til grus og stein. Det er ikke skilt mellom breelv- og elveavsetninger. Brukes kun i spesielle tilfeller.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>10</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Ryggformet breelvavsetning (Esker)</sc:name>
       <sc:id>C20_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sortert og lagdelt materiale, vesentlig sand og grus, avsatt i tunneler eller sprekker i breen. Der avsetningen er stor nok til å danne figur på kartet brukes fargen for breelvavsetninger til å angi utbredelsen og eskersymbolet til å angi ryggformen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>11</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Haugformet breelvavsetning (Kame)</sc:name>
       <sc:id>C20_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale avsatt av smeltevann i hulrom i breen. Store avsetninger gis fargen for breelvavsetninger i kombinasjon med symbol for kame.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>12</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bresjø-/eller brekammeravsetning (Glasilakustrin avsetning)</sc:name>
       <sc:id>C20_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Finkornig materiale avsatt i bresjø eller vannfylt brekammer hvor tykkelsen er mer enn 0,5 m og arealdekningen er stor nok til å danne figur på kartet. Mektigheten kan være flere ti-talls meter.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>13</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Breelv- og bresjø-/brekammeravsetning (Glasifluvial og glasilakustrin avsetning)</sc:name>
       <sc:id>C20_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale avsatt av breelv eller i bredemte sjøer/brekammer. Det er ikke skilt mellom breelv- og bresjø-/kammeravsetninger.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>14</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Innsjøavsetning (Lakustrin avsetning)</sc:name>
       <sc:id>C20_15</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale avsatt i innsjøer hvor tykkelsen er mer enn 0,5 m.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>15</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bresjø-/brekammer og innsjøavsetning (Glasilakustrin og lakustrin avsetning)</sc:name>
       <sc:id>C20_16</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Benyttes hvis en ønsker å slå sammen de to avsetningstypene. I tilfelle brukes ikke separate farger for bresjø og innsjø på det samme kartbladet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>16</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Strandavsetning, innsjø og/eller bresjø</sc:name>
       <sc:id>C20_17</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Strandvaskede sedimenter med mektighet større enn 0,5 m, dannet ved bølgeaktivitet i ferskvann. Materialet er ofte rundet og godt sortert. Kornstørrelsen varierer, men sand og grus er vanligst.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>17</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Hav- og fjordavsetning, uspesifisert</sc:name>
       <sc:id>C20_18</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Benyttes ved kartframstilling i svært små målestokker der en ikke skiller etter mektighet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>18</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Hav- og fjordavsetning, sammenhengende dekke, ofte med stor mektighet</sc:name>
       <sc:id>C20_19</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Finkornige, marine avsetninger med mektighet fra 0,5 m til flere ti-tall meter. Avsetningstypen omfatter også skredmasser fra kvikkleireskred, ofte angitt med tilleggssymbol. Det er få eller ingen fjellblotninger i området.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>19</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Marin strandavsetning, sammenhengende dekke</sc:name>
       <sc:id>C20_20</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Marine strandvaskede sedimenter med mektighet større enn 0,5 m, dannet av bølge- og strømaktivitet i strandsonen, stedvis som strandvoller. Materialet er ofte rundet og godt sortert. Kornstørrelsen varierer fra sand til blokk, men sand og grus er vanligst. Strandavsetninger ligger som et forholdsvis tynt dekke over berggrunn eller andre sedimenter.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>20</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Hav- og fjordavsetning  og strandavsetning, usammenhengende eller tynt dekke over berggrunnen</sc:name>
       <sc:id>C20_21</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder/hyppige fjellblotninger. Tykkelsen på avsetningene er normalt mindre enn 0,5 m, men den kan helt lokalt være noe større. Det er ikke skilt mellom hav-, fjord- og strandavsetning. Kornstørrelser angis normalt ikke, men kan være alt fra leir til blokk.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>21</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skjellsand</sc:name>
       <sc:id>C20_22</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning som i stor grad består av knuste skall av kalkutskillende organismer. Er en type av bioklastisk materiale. Kornstørrelse varierer fra nesten hele skall til sand. Det kan være ansamlet store mengder av skjellsand i umiddelbar nærhet av gode skjellvekstområder.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>22</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Marin gytje</sc:name>
       <sc:id>C20_23</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning som består av finkornig materiale, silt og leir med høyt organisk innhold. Det organiske materialet er primærprodusert i vannmassene. Marin gytje finnes i områder hvor det er liten materialtransport fra land. Brukes sjelden.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>23</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Elve- og bekkeavsetning (Fluvial avsetning)</sc:name>
       <sc:id>C20_24</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale som er transportert og avsatt av elver og bekker. De mest typiske formene er elvesletter, terrasser og vifter. Sand og grus dominerer, og materialet er sortert og rundet. Mektigheten varierer fra 0,5 til mer enn 10 m.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>24</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Elveavsetning, sammenhengende dekke</sc:name>
       <sc:id>C20_25</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale som er transportert og avsatt av elver og bekker. De mest typiske formene er elvesletter, terrasser og vifter. Sand og grus dominerer, og materialet er sortert og rundet. Brukes kun i spesielle tilfeller.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>25</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Elveavsetning, usammenhengende/tynt dekke</sc:name>
       <sc:id>C20_26</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med elveavsetninger. Brukes kun i spesielle tilfeller.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>26</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Flomavsetning (uspesifisert)</sc:name>
       <sc:id>C20_27</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brukes for spesielle sedimenter avsatt ved plutselig uttapning av bresjøer.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>27</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Flomavsetning, sammenhengende</sc:name>
       <sc:id>C20_28</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brukes for spesielle sedimenter avsatt ved plutselig uttapning av bresjøer.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>28</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Flomavsetning, usammenhengende/tynt</sc:name>
       <sc:id>C20_29</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brukes for spesielle sedimenter avsatt ved plutselig uttapning av bresjøer. Tykkelse mindre enn 0,5 m.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>29</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Vindavsetning (Eolisk avsetning)</sc:name>
       <sc:id>C20_30</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Flygesand med tykkelse mer enn 0,5 m.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>30</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Forvitringsmateriale, ikke inndelt etter mektighet</sc:name>
       <sc:id>C20_31</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Løsmasser dannet på stedet ved fysisk eller kjemisk nedbryting av berggrunnen. Gradvis overgang til underliggende fast fjell. Brukes når en ikke skiller mellom sammenhengende og usammenhengende dekke av denne avsetningstypen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>31</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Forvitringsmateriale, sammenhengende dekke</sc:name>
       <sc:id>C20_32</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Løsmasser dannet på stedet ved fysisk eller kjemisk nedbryting av berggrunnen. Tykkelsen er mer enn 0,5 m.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>32</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Forvitringsmateriale, usammenhengende eller tynt dekke over berggrunnen</sc:name>
       <sc:id>C20_33</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Løsmasser dannet på stedet ved fysisk eller kjemisk nedbryting av berggrunnen. Grunnlendt område med tallrike fjellblotninger.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>33</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Forvitringsmateriale, stein- og blokkrikt, dannet ved frostsprengning</sc:name>
       <sc:id>C20_34</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Blokkhav, oftest i fjellområder.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>34</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredmateriale, ikke inndelt etter mektighet</sc:name>
       <sc:id>C20_35</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetninger dannet ved steinsprang, fjellskred, snø- eller løsmasseskred fra bratte dalsider. Uspesifisert tykkelse.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>35</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredmateriale, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_36</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetninger dannet ved steinsprang, fjellskred, snøskred eller løsmasseskred fra bratte dalsider. Symbol viser dominerende skredtype. Tykkelsen er mer enn 0,5 m og det er få fjellblotninger i området.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>36</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredmateriale, usammenhengende eller tynt dekke over berggrunnen</sc:name>
       <sc:id>C20_37</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med avsetninger fra steinsprang, fjellskred, snø- og løsmasseskred fra bratte dalsider. Symbol viser dominerende skredtype. Tykkelse mindre enn 0,5 m.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>37</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Steinbreavsetning</sc:name>
       <sc:id>C20_38</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Steinur som inneholder/har inneholdt is og derfor er i bevegelse/har vært i bevegelse som en vanlig bre. Avsetningstypen dannes under permafrostforhold.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>38</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Torv og myr (Organisk materiale)</sc:name>
       <sc:id>C20_39</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Organisk jord dannet av døde planterester, med mektigheter større enn 0,5 m. Det skilles ikke mellom ulike torvtyper.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>39</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Humusdekke/tynt torvdekke over berggrunn</sc:name>
       <sc:id>C20_40</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Områder hvor humusdekket ligger rett på berggrunnen. Mektigheten av humusdekket er vanligvis 0,2 - 0,5 m, men kan lokalt være tykkere. Fjellblotninger opptrer hyppig innen slike områder. Fjellblotninger opptrer hyppig innen slike områder.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>40</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Usammenhengende eller tynt løsmassedekke over berggrunnen, flere løsmassetyper, uspesifisert</sc:name>
       <sc:id>C20_41</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Forskjellige sedimenter som danner et tynt eller usammenhengende dekke over berggrunnen. Denne betegnelsen brukes bare i spesielle tilfeller når en ikke velger å skille mellom ulike typer av løsmasser.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>41</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Sammenhengende løsmassedekke av flere jordarter</sc:name>
       <sc:id>C20_42</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Vanligvis skredmateriale med morenemateriale, forvitringsmateriale, torv og humus sterkt blanda ved skråningsprosesser. Brukes kun i spesielle tilfeller der det er meget vanskelig å skille mellom opprinnelige løsmassetyper.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>42</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bart fjell/fjell med tynt torvdekke, uspesifisert</sc:name>
       <sc:id>C20_43</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brukes når en ikke velger å skille mellom bart fjell og humusdekke eller tynt torvdekke over berggrunnen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>43</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Fyllmasse (antropogent materiale)</sc:name>
       <sc:id>C20_44</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Løsmasser tilført eller sterkt påvirket av menneskers aktivitet, vesentlig i urbane områder.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>44</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Steintipp</sc:name>
       <sc:id>C20_45</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tilførte steinmasser.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>45</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Menneskepåvirket materiale, ikke nærmere spesifisert</sc:name>
       <sc:id>C20_46</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dominerende stedegne masser, omarbeidet i overflaten.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>46</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bart fjell</sc:name>
       <sc:id>C20_47</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brukes om områder som stort sett mangler løsmasser, mer enn 50 % av arealet er fjell i dagen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>47</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bart fjell/fjell med usammenhengende eller  tynt løsmassedekke</sc:name>
       <sc:id>C20_48</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brukes på oversiktskart der bart fjell slås sammen med alle typer tynt eller usammenhengende løsmassedekke.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>48</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Marin suspensjonsavsetning</sc:name>
       <sc:id>C20_49</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Finkornige (leire, silt) sedimenter transportert og avsatt fra suspensjon. Draperer vanligvis underliggende sedimenter eller fjell og er oftest lagdelt.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>49</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Marin bunnstrømavsetning</sc:name>
       <sc:id>C20_50</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sedimenter som består av sand og grus transportert og avsatt fra bunnstrømmer. Dekker bunnen av undersjøiske kanaler laget av bunnstrømmer. Har ofte kryss-sjiktet og lentikulær- sjiktet indre struktur.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>50</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Glasimarin avsetning</sc:name>
       <sc:id>C20_51</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Hovedsakelig finkornige suspensjonsavsetninger (silt, leire) avsatt i nærhet av is/isbreer. Kan være påvirket av bunnstrømmer og utjevner topografien mer enn draperer. Forekommer i mektige lag i områder på kontinentalhyllen langs kysten og i fjorder</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>51</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Iskontaktavsetning</sc:name>
       <sc:id>C20_52</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sedimenter avsatt i kontakt med is. Kan være morene, glasifluvialt materiale, eller en blanding av glasialt avsatte sedimenter. Kornstørrelsen veksler mellom leire og grus alt etter hvilke prosesser som virket.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>52</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Utvaskingslag</sc:name>
       <sc:id>C20_53</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sedimenter bestående av sand, grus og bergartsfragmenter etter at finstoffet er vasket vekk av bølger og strøm. Danner et dekkende lag over morene eller andre jordarter med stor variasjon i kornstørrelser.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>53</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Glasifluvial deltaavsetning (marin)</sc:name>
       <sc:id>C20_54</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sedimenter transportert av breelver og avsatt i hav, bresjø eller innsjø.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>54</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Fluvial deltaavsetning</sc:name>
       <sc:id>C20_55</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sedimenter avsatt ved utløpet av en elv i en fjord, innsjø eller i havet. Kornstørrelsen er ofte i sandfraksjonen nær elveutløpet og mer finkornig på dypere vann. Har typisk skrålaging med helling i strømretningen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>55</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Tidevannsavsetning</sc:name>
       <sc:id>C20_56</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning dannet i kystnære områder ved tidevannstransport. Sedimentene er sandige til leirholdige med typiske strukturer som sanddyner, rifler, kryss-sjikting, mikro-kryss-sjikting, flasersjikting og lentikulær sjikting.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>56</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Estuarin avsetning</sc:name>
       <sc:id>C20_57</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Et sediment avsatt i brakkvann i et estuarie. Sedimentet er karakterisert av finkornig materiale (silt, leire) av marin og fluvial opprinnelse blandet med en høy andel rester av terrestrisk organisk materiale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>57</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Levé avsetning (marin)</sc:name>
       <sc:id>C20_58</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning dannet som en forhøyning av sedimenter langs en eller begge sidene  av en undersjøisk kanal (kløft, viftedal eller dyphavskanal). Avsetningen kan ha varierende kornstørrelse, fra finkornig (leir) til nokså grovt materiale (sand).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>58</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Grunnmarin avsetning</sc:name>
       <sc:id>C20_59</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sedimenter avsatt i turbulent grunt marint miljø der det fineste materialet er vasket ut og transportert til dypere vann av strømmer og bølger. Består av sand, grus og stein. I områder med mye sand kan sandbølger bygges med en karakteristisk kryss-sjikting og skrålaging.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>59</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Konturittavsetning</sc:name>
       <sc:id>C20_60</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Klastiske sedimenter transportert og avsatt av kontur-strømmer langs egga kanten. Består av fint, velsortert materiale (silt og leir). Avsetningene har vanligvis horisontal- eller kryss-sjiktning og normal- eller omvendt gradering.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>60</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Turbitittavsetning</sc:name>
       <sc:id>C20_61</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetninger dannet ved sedimenttransport og utfelling fra en turbidittstrøm.  Består av materiale i kornstørrelse fra leire til sand og er ofte karakterisert ved normalgradert lagning og moderat til dårlig sortering. Finnes oftest ved foten av skråninger med stor mektighet av løse sedimenter (for eksempel langs kontinentalskråningen).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>61</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Debrisstrømavsetning</sc:name>
       <sc:id>C20_62</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning fra en flytende masse av stein, jord og slam. Den består av usortert materiale der mer enn halvparten av partiklene er større enn sandstørrelse.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>62</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Undersjøisk vifteavsetning</sc:name>
       <sc:id>C20_63</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>En konisk eller vifteformet avsetning beliggende ved munningen av en undersjøisk kløft. Består for det meste av fine sedimenter (leire, silt). Viften har en finlaget indre struktur med en svak helling av lagene mot dyphavet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>63</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Kanalsavsetning</sc:name>
       <sc:id>C20_64</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sedimenter avsatt i en kanal. Avsetningene vil vanligvis bestå av relativt grove sedimenter (sand, grus)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>64</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Dypmarin avsetning</sc:name>
       <sc:id>C20_65</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Samlebetegnelse på dyphavssedimenter. Kan være både konturittisk, hemipelagisk, eupelagisk osv. Dette er fine sedimenter bunnfelt utenfor kontinentalmarginen. Består i stor grad av leire og rester av pelagiske organismer.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>65</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bioklastisk avsetning</sc:name>
       <sc:id>C20_66</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sediment som for en stor del består av små partikler av biologisk opprinnelse (skjell, korall). Kornstørrelsen kan variere fra sand til hele skjell eller korallkolonier. Forekommer i begrensete områder der vekstforholdene har vært optimale over lengre tid og mengden av annet klastisk materiale liten.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>66</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Vulkanosedimentær avsetning</sc:name>
       <sc:id>C20_67</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning som består av materiale av vulkansk opprinnelse. Alt etter kornstørrelse kan sedimentene deles inn i vulkansk aske, lapilli (2-64 mm) og breksje (&gt;64mm).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>67</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lagdelte sedimenter (&gt;1 m) over debrisstrøm</sc:name>
       <sc:id>C20_68</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Lagdelte sedimenter (&gt;1m) over debrisstrømavsetning.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>68</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredmateriale, dekket av yngre sedimenter</sc:name>
       <sc:id>C20_69</sc:id>
       <sc:sequenceNumber>69</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredmateriale, delvis dekket av yngre sedimenter</sc:name>
       <sc:id>C20_70</sc:id>
       <sc:sequenceNumber>70</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredmateriale og hemipelagiske avsetninger</sc:name>
       <sc:id>C20_71</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Veksling mellom skredavsetninger og hemipelagiske avsetninger. Hemipelagiske avsetninger består stort sett av finkornet materiale, delvis produsert i vannmassene lokalt, og delvis tilført utenifra.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>71</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Uspesifisert marin avsetning</sc:name>
       <sc:id>C20_72</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Marin avsetning med ukjent opprinnelse.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>72</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Jordskredavsetning, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_73</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning som dannes når løsmasser i bratt terreng løsner og raser nedover. Danner ofte karakteristiske vifte- eller tungelignende former.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>73</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Jordskredavsetning, usammenhengende eller tynt dekke</sc:name>
       <sc:id>C20_74</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendt avsetning som dannes når løsmasser i bratt terreng løsner og raser nedover.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>74</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Leirskredavsetning, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_75</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning som dannes når leirholdige sedimenter løsner og glir ut.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>75</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Leirskredavsetning, usammenhengende eller tynt dekke over berggrunnen</sc:name>
       <sc:id>C20_76</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avsetning som dannes når leirholdige sedimenter løsner og glir ut.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>76</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Fjellskredavsetning, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_77</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dannes når store fjellparti løsner og med kolossal kraft går ned i daler og fjorder. Består mest av kantete blokker.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>77</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Fjellskredavsetning, usammenhengende eller tynt dekke</sc:name>
       <sc:id>C20_78</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med fjellskredmateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>78</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Steinsprangavsetning, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_79</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale som har løsnet fra fast fjell og over tid akkumulert som bratte urer ved foten av skråninger. Materialet varierer fra sand til blokk, med økende kornstørrelse nedover skråningen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>79</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Steinsprangavsetning, usammenhengende eller tynt dekke</sc:name>
       <sc:id>C20_80</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med steinsprangmateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>80</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Snøskredavsetning, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_81</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dannes i områder med gjentatte snøskred og har ofte vifteform.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>81</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Snøskredavsetning, usammenhengende eller tynt dekke</sc:name>
       <sc:id>C20_82</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med snøskredmateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>82</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Fjellskred-/steinsprangavsetning, sammenhengende dekke, stedvis med stor mektighet</sc:name>
       <sc:id>C20_83</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Materiale bestående av steinblokker fra større fjellparti som har løsnet og rast ned. Består hovedsakelig av usortert grovt materiale (stein og blokk) og finnes oftest ved foten av skrenter/fjellsider.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>83</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Fjellskred-/steinsprangavsetning, usammenhengende eller tynt dekke</sc:name>
       <sc:id>C20_84</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med fjellskred-/steinsprangmateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>84</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Snø- og jordskredavsetning, sammenhengende dekke</sc:name>
       <sc:id>C20_85</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dannes i områder med vekslende snø- og jordskred.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>85</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Snø- og jordskredavsetning, usammenhengende eller tynt dekke</sc:name>
       <sc:id>C20_86</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med snøskredmateriale og jordskredmateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>86</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Jordskred- og steinsprangavsetning, sammenhengende dekke</sc:name>
       <sc:id>C20_87</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dannes i bratt terreng der både jordskred og steinsprang forekommer.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>87</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Jordskred- og steinsprangavsetning, usammenhengende eller tynt dekke</sc:name>
       <sc:id>C20_88</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grunnlendte områder med jordskred- og steinsprangmateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>88</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Finkornig organiskholdig sigejord</sc:name>
       <sc:id>C20_89</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sterkt frostpåvirket blandingsmateriale som beveger seg sakte nedover slake skråninger, dannet fra en eller flere opprinnelig finstoffholdige løsmassetyper.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>89</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Steinrikt sigende skråningsmateriale</sc:name>
       <sc:id>C20_90</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Grovkornig frostpåvirket blandingsmateriale som beveger seg sakte nedover skråninger, dannet fra forvitret fjell, skråningsmateriale eller morenemateriale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>90</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
   </sc:classes>
