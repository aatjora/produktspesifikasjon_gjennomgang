    <sc:Package>
     <sc:name>GrusPukkObservasjonOgUttak</sc:name>
     <sc:id>P3</sc:id>
     <sc:classes>
      <sc:Class>
       <sc:name>PukkUttak</sc:name>
       <sc:id>C3</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
