@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Grus og pukk - Ny datakilde - GrusPukkOmråder

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "GrusPukkOmråder" {

  class SandGrusOmr <<featureType>> {
    + område [1] : Flate
    + identRastoffobj [1] : Integer
    + forekomstNummer [1] : Integer
    + materialType [1] : MaterialType
    + rastoffBetydning [1] : RastoffBetydning
    + mineralRegistreringType [0..1] : MineralRegistreringType
    + navnRastoffobj [0..1] : CharacterString
    + typeRastoffVirksomhet [0..1] : TypeRastoffVirksomhet
    + geolBeskrivelse [0..1] : CharacterString
    + geolBeskrivelseURL [0..1] : CharacterString
    + antallAnalyser [0..1] : Integer
    + avfallType [0..1] : Integer
    + rastoffVolum [0..1] : Integer
    + sisteBefaringdato [0..1] : Integer
  }

  class PukkOmr <<featureType>> {
    + område [1] : Flate
    + identRastoffobj [1] : Integer
    + forekomstNummer [1] : Integer
    + materialType [1] : MaterialType
    + rastoffBetydning [1] : RastoffBetydning
    + mineralRegistreringType [0..1] : MineralRegistreringType
    + navnRastoffobj [0..1] : CharacterString
    + typeRastoffVirksomhet [0..1] : TypeRastoffVirksomhet
    + geolBeskrivelse [0..1] : CharacterString
    + geolBeskrivelseURL [0..1] : CharacterString
    + antallAnalyser [0..1] : Integer
    + sisteBefaringdato [0..1] : Integer
  }
}

package "Eksterne referanser" <<Frame>> {
  class FelleskomponenterGrusPukk <<GrusPukk 3.0>> {
  }
  class GeolAvgrLinje <<GrusPukk 3.0>> {
  }
  class PukkObservasjon <<GrusPukkObservasjonOgUttak>> {
  }
  class PukkRegistrering <<GrusPukkRegistreringer>> {
  }
  class PukkUttak <<GrusPukkObservasjonOgUttak>> {
  }
  class RastoffProvePkt <<Spesielle>> {
  }
  class SandGrusObservasjon <<GrusPukkObservasjonOgUttak>> {
  }
  class SandGrusRegistrering <<GrusPukkRegistreringer>> {
  }
  class SandGrusUttak <<GrusPukkObservasjonOgUttak>> {
  }
}

FelleskomponenterGrusPukk <|-- SandGrusOmr
SandGrusOmr --> GeolAvgrLinje : grusPukkOmråderAvgrensning [1..*]
SandGrusOmr --> SandGrusUttak : inneholder [0..*]
SandGrusOmr --> SandGrusObservasjon : inneholder [0..*]
SandGrusOmr --> SandGrusRegistrering : inneholder [0..*]
SandGrusOmr --> RastoffProvePkt : inneholder [0..*]
FelleskomponenterGrusPukk <|-- PukkOmr
PukkOmr --> GeolAvgrLinje : grusPukkOmråderAvgrensning [1..*]
PukkOmr --> PukkUttak : inneholder [0..*]
PukkOmr --> PukkObservasjon : inneholder [0..*]
PukkOmr --> RastoffProvePkt : inneholder [0..*]
PukkOmr --> PukkRegistrering : inneholder [0..*]

@enduml
