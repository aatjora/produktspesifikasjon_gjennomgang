@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Stemmekretser - stortings- og sametingsvalget 2025 - UML - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  abstract class SOSI_Objekt <<featureType>> {
    + datafangstdato [0..1] : Date
    + førsteDigitaliseringsdato [1] : Date
    + kvalitet [0..1] : Posisjonskvalitet
    + opphav [0..1] : CharacterString
    + informasjon [0..*] : CharacterString
  }

  class Grense <<featureType>> {
    + grense [1] : GM_Curve
    + avgrensningstype [1] : TypeAvgrensning
  }

  class Fylke <<featureType>> {
    + samiskForvaltningsområde [0..1] : Boolean
    + fylkesnummer [1] : Fylkesnummer
  }

  class AdministrativEnhet <<featureType>> {
    + område [0..1] : GM_MultiSurface
    + posisjon [0..1] : GM_Point
    + land [0..1] : Landkode
    + administrativKode [0..1] : CharacterString
  }

  class Stemmekrets <<featureType>> {
    + område [1] : GM_MultiSurface
    + stremmekretsid [1] : StemmekretsId
    + kommunenummer [1] : Kommunenummer
  }

  class Kommune <<featureType>> {
    + samiskForvaltningsområde [0..1] : Boolean
  }

  abstract class SOSI_Fellesegenskaper <<featureType>> {
    + identifikasjon [1] : Identifikasjon
    + oppdateringsdato [1] : Date
    + gyldigFra [0..1] : Date
    + gyldigTil [0..1] : Date
  }

  class Posisjonskvalitet <<dataType>> {
    + målemetode [1] : Målemetode
    + nøyaktighet [0..1] : Integer
    + synbarhet [0..1] : Synbarhet
    + målemetodeHøyde [0..1] : MålemetodeHøyde
    + nøyaktighetHøyde [0..1] : Integer
    + maksimaltAvvik [0..1] : Integer
  }

  class StemmekretsId <<dataType>> {
    + stemmekretsnummer [1] : CharacterString
    + stemmekretsnavn [1] : CharacterString
    + tellekretsnummer [0..1] : CharacterString
    + tellekretsnavn [0..1] : CharacterString
    + valgdistriktsnummer [0..1] : CharacterString
  }

  class Identifikasjon <<dataType>> {
    + lokalId [1] : CharacterString
    + navnerom [1] : CharacterString
    + versjonId [0..1] : CharacterString
  }
}

  SOSI_Fellesegenskaper <|-- SOSI_Objekt
  SOSI_Objekt <|-- Grense
  AdministrativEnhet <|-- Fylke
  SOSI_Objekt <|-- Stemmekrets
  Stemmekrets --> Grense : stemmekretsgrense [1..*]
  Stemmekrets --> Fylke : fylke [1]
  Stemmekrets --> Kommune : kommune [1]
  AdministrativEnhet <|-- Kommune

@enduml
