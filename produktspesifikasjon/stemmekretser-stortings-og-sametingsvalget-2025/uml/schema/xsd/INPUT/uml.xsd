    </annotation>
  </element>
  <complexType name="AdministrativEnhetType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element minOccurs="0" name="område" type="gml:MultiSurfacePropertyType">
            <annotation>
              <documentation>objektets utstrekning</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="posisjon" type="gml:PointPropertyType">
            <annotation>
              <documentation>sted som objektet eksisterer på</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="land" type="uml:LandkodeType">
            <annotation>
              <documentation>stat som den administrative enheten hører til

