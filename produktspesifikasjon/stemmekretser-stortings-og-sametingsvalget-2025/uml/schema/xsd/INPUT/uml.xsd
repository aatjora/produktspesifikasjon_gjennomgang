              <appinfo>
                <sc:taggedValue tag="SOSI_navn">STEMMEKRETSID</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="kommunenummer" type="uml:KommunenummerType">
            <annotation>
              <documentation>nummerering av kommunen i henhold til Statistisk sentralbyrå sin offisielle liste

Merknad: Det presiseres at kommune alltid skal ha 4 siffer, dvs. eventuelt med ledende null. Kommune benyttes for kopling mot en rekke andre registre som også benytter 4 siffer.</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/inndelinger/inndelingsbase/kommunenummer</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element maxOccurs="unbounded" name="stemmekretsgrense" type="uml:GrensePropertyType"/>
