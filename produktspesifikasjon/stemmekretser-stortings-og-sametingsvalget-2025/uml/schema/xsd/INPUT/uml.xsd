            </annotation>
          </element>
          <element minOccurs="0" name="administrativKode" type="string">
            <annotation>
              <documentation>tematisk identifikator som tilsvarer kode for den nasjonale administrative inndelingen

Merknad: I Norge skal alltid fire sifre benyttes. For eksempel Ringerike kommune: 3007; Viken fylke: 3000; Norge: 0000</documentation>
            </annotation>
          </element>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
