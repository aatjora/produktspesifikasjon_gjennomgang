      <sc:Class>
       <sc:name>Stemmekrets</sc:name>
       <sc:id>C5</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>stemmekretsene har som formål å være en hensiktsmessig inndeling av kommuner ved valg, bl.a. for at velgerne ikke skal få for stor avstand til valglokalet

Merknad: Inndelingen skal ivareta administrative formål, men har også i en viss grad blitt nyttet til å samle inn statistikk for planleggingsformål.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C1</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>område</sc:name>
         <sc:id>C5_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>den geografiske avgrensingen av stemmekretsen.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>GM_MultiSurface</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>stremmekretsid</sc:name>
         <sc:id>C5_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>&lt;font color="#1f497d"&gt;navn og nummer for stemmekrets og eventuelt tilhørighet til tellekrets, valgdistrikt og fylke.&lt;/font&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>STEMMEKRETSID</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C9</sc:typeId>
         <sc:typeName>StemmekretsId</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>kommunenummer</sc:name>
         <sc:id>C5_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>nummerering av kommunen i henhold til Statistisk sentralbyrå sin offisielle liste

Merknad: Det presiseres at kommune alltid skal ha 4 siffer, dvs. eventuelt med ledende null. Kommune benyttes for kopling mot en rekke andre registre som også benytter 4 siffer.</sc:DescriptorValue>
           </sc:descriptorValues>
